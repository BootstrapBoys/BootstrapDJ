// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model AutoplaySetting {
  guildId   String   @id
  source    String   @default("chart")
  seeds     String   @default("")
  updatedAt DateTime @updatedAt
}

model GuildSetting {
  guildId   String
  key       String
  value     String
  updatedAt DateTime @updatedAt

  @@id([guildId, key])
}

model PermissionRule {
  id         String  @id @default(uuid())
  guildId    String
  command    String
  targetId   String
  targetType String
  allow      Boolean @default(false)

  @@unique([guildId, command, targetId, targetType])
}

model CommandAlias {
  id      String @id @default(uuid())
  guildId String
  scope   String
  userId  String @default("")
  alias   String
  command String

  @@unique([guildId, scope, userId, alias])
}

model Guild {
  guildId    String      @id
  prefix     String
  stay       Stay?
  dj         Dj?
  roles      Role[]
  botchannel Botchannel?
  setup      Setup?
  voiceListen VoiceListen?
  voiceOptOuts VoiceListenOptOut[]
}

model Stay {
  guildId String @id
  textId  String
  voiceId String
  Guild   Guild  @relation(fields: [guildId], references: [guildId])
}

model Dj {
  guildId String  @id
  mode    Boolean
  Guild   Guild   @relation(fields: [guildId], references: [guildId])
}

model Role {
  guildId String
  roleId  String
  Guild   Guild  @relation(fields: [guildId], references: [guildId])

  @@unique([guildId, roleId])
}

model Playlist {
  id     String @id @default(uuid())
  userId String
  name   String
  songs  Song[]

  @@unique([userId, name])
}

model Song {
  id         String   @id  @default(uuid())
  track      String
  playlistId String
  playlist   Playlist @relation(fields: [playlistId], references: [id])

  @@unique([track, playlistId])
  @@index([playlistId])
}

/// Playback state for crash/restart recovery. One row per guild; deleted when
/// playback ends normally so a later boot has nothing to resurrect.
model Session {
  guildId   String   @id
  textId    String
  voiceId   String
  current   String?
  queue     String
  loop      String   @default("off")
  autoplay  Boolean  @default(false)
  volume    Int      @default(100)
  paused    Boolean  @default(false)
  updatedAt DateTime @updatedAt
}

model Botchannel {
  guildId String @id
  textId  String
  Guild   Guild  @relation(fields: [guildId], references: [guildId])
}

model Setup {
  guildId   String @id
  textId    String
  messageId String
  Guild     Guild  @relation(fields: [guildId], references: [guildId])
}

model Premium {
  userId  String @id
  guildId String
}


/// Guild-level voice-listening state. Off by default; /listen flips it.
model VoiceListen {
  guildId        String   @id
  enabled        Boolean  @default(false)
  voiceChannelId String?
  textChannelId  String?
  updatedBy      String?
  updatedAt      DateTime @updatedAt
  Guild          Guild    @relation(fields: [guildId], references: [guildId])
}

/// Members whose frames must be dropped before STT when listening is active.
model VoiceListenOptOut {
  guildId    String
  userId     String
  createdAt  DateTime @default(now())
  Guild      Guild    @relation(fields: [guildId], references: [guildId])

  @@id([guildId, userId])
}
