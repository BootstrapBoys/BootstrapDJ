// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model Guild {
  guildId    String      @id
  prefix     String
  stay       Stay?
  dj         Dj?
  roles      Role[]
  botchannel Botchannel?
  setup      Setup?
}

model Stay {
  guildId String @id
  textId  String
  voiceId String
  Guild   Guild  @relation(fields: [guildId], references: [guildId])
}

model Dj {
  guildId String  @id
  mode    Boolean
  Guild   Guild   @relation(fields: [guildId], references: [guildId])
}

model Role {
  guildId String
  roleId  String
  Guild   Guild  @relation(fields: [guildId], references: [guildId])

  @@unique([guildId, roleId])
}

model Playlist {
  id     String @id @default(uuid())
  userId String
  name   String
  songs  Song[]

  @@unique([userId, name])
}

model Song {
  id         String   @id  @default(uuid())
  track      String
  playlistId String
  playlist   Playlist @relation(fields: [playlistId], references: [id])

  @@unique([track, playlistId])
  @@index([playlistId])
}

/// Playback state for crash/restart recovery. One row per guild; deleted when
/// playback ends normally so a later boot has nothing to resurrect.
model Session {
  guildId   String   @id
  textId    String
  voiceId   String
  current   String?
  queue     String
  loop      String   @default("off")
  autoplay  Boolean  @default(false)
  volume    Int      @default(100)
  paused    Boolean  @default(false)
  updatedAt DateTime @updatedAt
}

model Botchannel {
  guildId String @id
  textId  String
  Guild   Guild  @relation(fields: [guildId], references: [guildId])
}

model Setup {
  guildId   String @id
  textId    String
  messageId String
  Guild     Guild  @relation(fields: [guildId], references: [guildId])
}

model Premium {
  userId  String @id
  guildId String
}
