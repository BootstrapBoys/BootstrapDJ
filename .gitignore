# Environment variables (never commit)
.env

# Editor
/.vscode

# Build output
/dist

# Dependencies
/node_modules

# Caches
/.eslintcache
/.next

# Non-npm lockfiles
/yarn.lock
/yarn-error.log
/pnpm-lock.yaml

# Generated Lavalink runtime config (copy example.application.yml)
/Lavalink/application.yml
/Lavalink/plugins

# Misc
/target

# Host-specific pm2 launcher (edited per machine)
DJBoot.sh
# Prisma 7 generates the client into src/ (regenerated by postinstall)
src/generated/

# Launcher state (hashes of the last successful boot)
.boot-state

# Local SQLite database (live data, never in git)
prisma/*.db
