{
    "name": "bootstrapdj",
    "version": "4.1.0",
    "description": "BootstrapDJ is a music bot for Discord, written in TypeScript using Discord.js, Shoukaku (Lavalink) and Prisma.",
    "main": "dist/index.js",
    "type": "module",
    "engines": { "node": ">=24.17.0" },
    "scripts": {
        "start": "npm run build && node dist/index.js",
        "prisma:generate": "npx prisma generate",
        "postinstall": "prisma generate",
        "build": "tsc --project tsconfig.json",
        "pretest": "npm run build",
        "test": "node --test tests/*.test.mjs",
        "clean": "rm -rf dist",
        "lint": "eslint . --cache",
        "lint:fix": "eslint . --fix --cache",
        "format": "prettier --check .",
        "format:fix": "prettier --write ."
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/zebz213/BootstrapDJ.git"
    },
    "keywords": [
        "discord",
        "music",
        "bot",
        "lavalink",
        "shoukaku",
        "bootstrapdj",
        "typescript",
        "prisma"
    ],
    "author": "Zebz213",
    "license": "GPL-3.0",
    "bugs": {
        "url": "https://github.com/zebz213/BootstrapDJ/issues"
    },
    "homepage": "https://github.com/zebz213/BootstrapDJ#readme",
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@types/node": "~26.6.6",
        "@types/signale": "^1.4.7",
        "eslint": "^10.14.0",
        "eslint-import-resolver-node": "^0.4.0",
        "eslint-plugin-import-x": "^4.17.1",
        "eslint-plugin-unicorn": "^79.0.0",
        "prettier": "^3.9.10",
        "prisma": "^7.10.1",
        "typescript": "~5.9.3",
        "typescript-eslint": "^8.72.1"
    },
    "dependencies": {
        "@prisma/adapter-better-sqlite3": "^7.10.1",
        "@prisma/client": "^7.10.1",
        "discord.js": "^14.28.0",
        "dotenv": "~18.0.9",
        "shoukaku": "^4.3.0",
        "signale": "^1.4.0",
        "tslib": "^2.9.1",
        "undici": "~8.12.3"
    },
    "signale": {
        "displayScope": true,
        "displayBadge": true,
        "displayDate": true,
        "displayFilename": true,
        "displayLabel": true,
        "displayTimestamp": true,
        "underlineLabel": true
    }
}
