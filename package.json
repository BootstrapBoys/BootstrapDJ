{
    "name": "bootstrapdj",
    "version": "4.1.0",
    "description": "BootstrapDJ is a music bot for Discord, written in TypeScript using Discord.js, Shoukaku (Lavalink) and Prisma.",
    "main": "dist/index.js",
    "type": "module",
    "engines": {
        "node": ">=24.17.0"
    },
    "scripts": {
        "start": "npm run build && node dist/index.js",
        "prisma:generate": "npx prisma generate",
        "postinstall": "prisma generate",
        "build": "tsc --project tsconfig.json",
        "pretest": "npm run build",
        "test": "node --test tests/*.test.mjs",
        "test:coverage": "npm run build && node --test --experimental-test-coverage tests/*.test.mjs",
        "dashboard": "node dist/dashboard/sidecar.js",
        "dashboard:dev": "node --watch dist/dashboard/sidecar.js",
        "soak": "node tooling/soak/run.mjs",
        "soak:bottest": "bash tooling/bottest-soak.sh",
        "soak:report": "node tooling/soak/report.mjs",
        "chaos:failover": "bash tooling/chaos/failover.sh",
        "chaos:isolated": "bash tooling/isolated-chaos.sh",
        "clean": "rm -rf dist",
        "i18n:validate": "node tooling/i18n-validate.mjs",
        "lint": "oxlint --type-aware --type-check --deny-warnings .",
        "lint:fix": "oxlint --type-aware --type-check --fix .",
        "format": "prettier --check .",
        "format:fix": "prettier --write ."
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/BootstrapBoys/BootstrapDJ.git"
    },
    "keywords": [
        "discord",
        "music",
        "bot",
        "lavalink",
        "shoukaku",
        "bootstrapdj",
        "typescript",
        "prisma"
    ],
    "author": "Zebz213",
    "license": "GPL-3.0",
    "bugs": {
        "url": "https://github.com/BootstrapBoys/BootstrapDJ/issues"
    },
    "homepage": "https://github.com/BootstrapBoys/BootstrapDJ#readme",
    "devDependencies": {
        "@types/node": "~26.6.6",
        "@types/signale": "^1.4.7",
        "oxlint": "^1.92.0",
        "oxlint-tsgolint": "^7.0.2006",
        "prettier": "^3.9.10",
        "prisma": "^7.10.1",
        "typescript": "^7.0.2"
    },
    "dependencies": {
        "@prisma/adapter-better-sqlite3": "^7.10.1",
        "@prisma/client": "^7.10.1",
        "discord.js": "^14.28.1",
        "dotenv": "~18.0.9",
        "i18next": "^27.1.1",
        "shoukaku": "^4.3.0",
        "signale": "^1.4.0"
    },
    "signale": {
        "displayScope": true,
        "displayBadge": true,
        "displayDate": true,
        "displayFilename": true,
        "displayLabel": true,
        "displayTimestamp": true,
        "underlineLabel": true
    }
}
