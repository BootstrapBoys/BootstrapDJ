# Discord
TOKEN="" # Bot token
PREFIX="!" # Prefix for text commands
OWNER_IDS=[] # JSON array of Discord user IDs with owner-only commands
GUILD_ID="" # Single-guild mode; blank registers commands globally
CLIENT_ID="" # Bot client ID, used by /invite and /about
PRODUCTION="true" # false only while developing

# Presence
BOT_STATUS="online" # online, idle, dnd, invisible
BOT_ACTIVITY="Bootstrap DJ"
BOT_ACTIVITY_TYPE=2 # 0 PLAYING, 1 STREAMING, 2 LISTENING, 3 WATCHING
IMG_LINK="https://i.imgur.com/ud3EWNh.jpg" # Image used in info embeds

# Music
SEARCH_ENGINE="ytsearch" # ytsearch, ytmsearch, scsearch, dzsearch (Deezer needs the LavaSrc plugin)
MAX_PLAYLIST_SIZE="100" # Tracks accepted from a playlist link
MAX_QUEUE_SIZE="100" # Tracks allowed in the queue
AUTOPLAY_CHART="true" # Use Deezer's chart for a cold-start seed (non-explicit tracks)
AUTOPLAY_SEEDS="NF, Hotel Books, Parker Jack" # Curated cold-start fallback seeds, comma-separated
AUTOPLAY_SEED="dj" # Legacy final fallback when no chart or curated seed resolves

# Message hygiene (seconds, 0 disables)
COMMAND_DELETE_AFTER="10" # Lifetime of a command reply
SETUP_CLEANUP_INTERVAL="30" # Sweep interval for the song-request channel

# Playback sessions
SESSION_RESTORE_AGE="21600" # How long a saved queue stays restorable
SESSION_EMPTY_WAIT="30" # Grace period for a listener to rejoin before the queue is dropped

# Database
DATABASE_URL="" # Blank uses file:./prisma/bootstrapdj.db

# Lavalink
AUTO_NODE="true" # Pick a probed public node when no LAVALINK_URL is set
LAVALINK_URL="lavalink:2333"
LAVALINK_AUTH="youshallnotpass"
LAVALINK_NAME="Bootstrap Node"
LAVALINK_SECURE="false" # true when the node is behind TLS (e.g. wss:// on 443)
# JSON array of standby nodes, tried in order after the primary. A second local
# Lavalink is the only reliable failover for voice: most public nodes cannot join
# a voice channel (no DAVE/E2EE support), they can only hold queue state.
# Wrap the value in single quotes — an unquoted password containing # gets cut
# off by dotenv and the node then fails the WebSocket handshake with 401.
LAVALINK_FALLBACKS='[{"name":"local-backup","url":"127.0.0.1:2334","auth":"pass","secure":false}]' 
NODE_FALLBACK="true" # Use a probed public node while the primary is down
NODE_FALLBACK_AFTER="180" # Seconds of continuous outage before switching to it
PUBLIC_NODE_LIST_URL="https://lavalink-list.ajieblogs.eu.org/All" # Public node list API
NODE_ALERT_REMINDER_MINUTES="15" # Minutes between "still unreachable" notices during an outage (0 disables)

# Voice listener (Earl the Ear)
EARL_CONTROL_URL="http://127.0.0.1:8791" # listener control API (localhost only)
EARL_BRIDGE_SECRET="" # shared secret; must equal BRIDGE_SECRET in Earl's .env
VOICE_BRIDGE_PORT="8790" # main bot voice bridge port (127.0.0.1)
EARL_LIVE_BADGE_URL="" # guild emoji PNG URL for the LIVE badge; blank uses the bundled attachment

# Logging
LOG_CHANNEL_ID="" # Channel that receives bot logs; blank disables

# Local dashboard (port 0 disables). Bind loopback unless you set a token.
DASHBOARD_PORT="0"
DASHBOARD_HOST="127.0.0.1"
DASHBOARD_TOKEN=""

# Multi-bot (optional; JSON file with mode 600)
BOTS_FILE=""
BOT_NAME=""
BOT_ID=""
