# BootstrapDJ environment
# Copy this file to .env and fill in the values. Never commit the real .env.
# Blank values use the defaults noted below. "0" disables a timer only where called out.

# ---------------------------------------------------------------------------
# Discord application
# ---------------------------------------------------------------------------
BOT_TOKEN=""                 # Preferred bot token from the Discord Developer Portal
TOKEN=""                     # Legacy alias; BOT_TOKEN wins when both are set
PREFIX="!"                   # Text-command prefix; comma-separate multiple prefixes
OWNER_IDS=[]                 # JSON array of user IDs allowed to run owner/dev commands
GUILD_ID=""                  # Single-guild mode; blank registers slash commands globally
CLIENT_ID=""                 # Application/client ID; used by /invite and /about
PRODUCTION="true"            # false = test/guild mode; true = production command scope

# ---------------------------------------------------------------------------
# Presence
# ---------------------------------------------------------------------------
BOT_STATUS="online"          # online, idle, dnd, invisible
BOT_ACTIVITY="Bootstrap DJ"  # Text shown in the bot's presence
BOT_ACTIVITY_TYPE=2          # 0 = playing, 1 = streaming, 2 = listening, 3 = watching
BOT_STATUS_MODE="static"     # static, track (main guild only), or count (active servers)
IMG_LINK="https://i.imgur.com/ud3EWNh.jpg"  # Fallback artwork in info embeds

# ---------------------------------------------------------------------------
# Music and search
# ---------------------------------------------------------------------------
SEARCH_ENGINE="ytsearch"            # Slash/default engine: ytsearch, ytmsearch, scsearch, dzsearch
PREFIX_SEARCH_ENGINE="ytsearch"     # Prefix commands use this; slash commands use searchtype/SEARCH_ENGINE
MAX_PLAYLIST_SIZE="100"             # Maximum tracks accepted from one playlist link
MAX_QUEUE_SIZE="100"                # Maximum tracks allowed in the queue
AUTOPLAY_CHART="true"               # Use the Deezer chart for a cold-start autoplay seed
AUTOPLAY_SEEDS="NF, Hotel Books, Parker Jack"  # Curated fallback seeds, comma-separated
AUTOPLAY_SEED="dj"                  # Legacy final fallback when chart/curated seeds fail

# ---------------------------------------------------------------------------
# Message hygiene (seconds)
# ---------------------------------------------------------------------------
COMMAND_DELETE_AFTER="10"           # Lifetime of a command reply; 0 keeps replies
SETUP_CLEANUP_INTERVAL="30"         # Sweep interval for the song-request channel; 0 disables

# ---------------------------------------------------------------------------
# Playback sessions
# ---------------------------------------------------------------------------
SESSION_RESTORE_AGE="21600"         # Seconds a saved queue stays restorable; 0 disables
SESSION_EMPTY_WAIT="30"             # Seconds to wait for a listener before dropping a restored queue

# ---------------------------------------------------------------------------
# Database and statistics retention
# ---------------------------------------------------------------------------
DATABASE_URL=""                     # Blank uses file:./prisma/bootstrapdj.db
# Daily history backs the dashboard's 7/30/90-day views. Inactive track/listener
# rows are trimmed, but each guild's top 100 rows are kept. WAL mode is enabled
# automatically at startup.
STATS_RETENTION_DAYS=90             # Days of StatsDaily history to keep; 0 disables
STATS_INACTIVE_DAYS=180             # Remove tracks/listeners inactive this long; 0 disables
STATS_PRUNE_INTERVAL_HOURS=24       # Retention job interval on the priority-0 bot; 0 disables

# ---------------------------------------------------------------------------
# Lavalink
# ---------------------------------------------------------------------------
AUTO_NODE="true"                    # Probe a public node when LAVALINK_URL is blank
LAVALINK_URL="lavalink:2333"        # Primary node host:port (no protocol)
LAVALINK_AUTH="youshallnotpass"     # Primary node password
LAVALINK_NAME="Bootstrap Node"      # Name shown in node status
LAVALINK_SECURE="false"             # true when the node uses TLS (for example wss:// on 443)
# JSON array of standby nodes, tried in order after the primary. A second local
# Lavalink is the only reliable voice failover; most public nodes cannot join a
# voice channel. Wrap the value in single quotes so a password containing "#"
# is not mistaken for a dotenv comment.
LAVALINK_FALLBACKS='[{"name":"local-backup","url":"127.0.0.1:2334","auth":"pass","secure":false}]'
NODE_FALLBACK="true"                # Use a probed public node while the primary is down
NODE_FALLBACK_AFTER="180"           # Seconds of continuous outage before switching
PUBLIC_NODE_LIST_URL="https://lavalink-list.ajieblogs.eu.org/All"  # Public node list API
NODE_ALERT_REMINDER_MINUTES="15"    # Minutes between "still unreachable" notices; 0 disables

# ---------------------------------------------------------------------------
# Voice listener (Earl the Ear)
# ---------------------------------------------------------------------------
EARL_CONTROL_URL="http://127.0.0.1:8791"  # Listener control API; keep on localhost
EARL_BRIDGE_SECRET=""                     # Must match BRIDGE_SECRET in Earl's .env
VOICE_BRIDGE_PORT="8790"                  # Main bot voice bridge port on 127.0.0.1
EARL_LIVE_BADGE_URL=""                    # Guild emoji PNG for LIVE; blank uses bundled attachment

# ---------------------------------------------------------------------------
# Logging
# ---------------------------------------------------------------------------
LOG_CHANNEL_ID=""                   # Channel for bot logs; blank disables logging

# ---------------------------------------------------------------------------
# Local dashboard
# ---------------------------------------------------------------------------
DASHBOARD_PORT="0"                  # 0 disables; set a port to start the dashboard
DASHBOARD_HOST="127.0.0.1"          # Keep loopback unless access is protected
DASHBOARD_PUBLIC_URL=""             # Public dashboard URL for /utility dashboard; blank derives the OAuth redirect origin
DASHBOARD_TOKEN=""                  # Local/token mode only; ignored when OAuth is configured
DASHBOARD_ALLOW_ANONYMOUS="false"   # Loopback-only opt-in for unauthenticated owner access; refused when DASHBOARD_PUBLIC_URL is set
# Dashboard OAuth (any member of a guild containing the bot). CLIENT_ID is used as
# fallbacks when the OAuth-specific values are blank.
DASHBOARD_OAUTH_CLIENT_ID=""
DASHBOARD_OAUTH_CLIENT_SECRET=""
DASHBOARD_OAUTH_REDIRECT_URI="https://dashboard.example.com/auth/callback"
DASHBOARD_SESSION_SECRET=""         # Random HMAC secret for the signed session cookie
DASHBOARD_OAUTH_GUILD_ID=""         # Legacy hint; dashboards auto-authorize every guild containing the bot

# ---------------------------------------------------------------------------
# Multi-bot (optional; BOTS_FILE must be a JSON file with mode 600)
# ---------------------------------------------------------------------------
BOTS_FILE=""                        # Path to the local bots/preferred-order JSON file
BOT_NAME=""                         # Name for this child (heartbeats, presence, leases)
BOT_ID=""                           # Application ID for this child
BOT_PRIORITY=""                     # 0 = primary/restore owner; 1, 2 = standby children

# True Discord sharding (optional). 0 = let Discord calculate the shard count.
# Shard 0 owns the dashboard, Earl bridge, command registration and retention.
SHARD_COUNT="0"
